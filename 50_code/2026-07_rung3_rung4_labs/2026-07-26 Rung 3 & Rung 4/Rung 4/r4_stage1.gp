default(parisize, 4500*1024*1024);
lg = "r4_progress.log";
write(lg, "=== rung4 stage1 start ===");
t0 = getabstime();
mf12 = mfinit([12000, 2, 12], 0);
write(lg, "mfinit chi12 newspace done: ", (getabstime()-t0)/1000.0, " s");
writebin("mf12.bin", mf12);
t0 = getabstime();
M3 = mfheckemat(mf12, 3);
write(lg, "U3 matrix chi12 done: ", (getabstime()-t0)/1000.0, " s; size ", matsize(M3)[1]);
writebin("M3_12.bin", M3);
t0 = getabstime();
cp = charpoly(M3);
n = poldegree(cp);
m = 0;
while(m < n && polcoef(cp, n - m - 1) != 0 && valuation(polcoef(cp, n - m - 1), 3) == 0, m++);
write(lg, "charpoly chi12 done: ", (getabstime()-t0)/1000.0, " s; U3-ordinary rank = ", m, " / ", n);
writebin("cp12.bin", cp);
t0 = getabstime();
mf60 = mfinit([12000, 2, 60], 0);
write(lg, "mfinit chi60 newspace done: ", (getabstime()-t0)/1000.0, " s");
writebin("mf60.bin", mf60);
t0 = getabstime();
M3b = mfheckemat(mf60, 3);
write(lg, "U3 matrix chi60 done: ", (getabstime()-t0)/1000.0, " s");
writebin("M3_60.bin", M3b);
cpb = charpoly(M3b);
nb = poldegree(cpb);
mb = 0;
while(mb < nb && polcoef(cpb, nb - mb - 1) != 0 && valuation(polcoef(cpb, nb - mb - 1), 3) == 0, mb++);
write(lg, "chi60 U3-ordinary rank = ", mb, " / ", nb);
writebin("cp60.bin", cpb);
write(lg, "=== stage1 COMPLETE ===");
quit;
